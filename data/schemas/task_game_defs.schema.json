{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task game definitions",
  "description": "The vocabulary of the game model of tasks: game types with their rules, defaults and values, the motivation questions, phase names, the ways two games combine, and the settings studies vary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "game_types",
    "motivation",
    "phases",
    "combinations",
    "settings"
  ],
  "properties": {
    "game_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "game_type",
          "name",
          "what_the_player_does",
          "boundary",
          "rules"
        ],
        "properties": {
          "game_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "what_the_player_does": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1,
            "description": "The sentence that decides whether a task has this game type."
          },
          "rules": {
            "type": "array",
            "description": "Empty for a game type with no type-specific rules.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rule",
                "question",
                "default",
                "values"
              ],
              "properties": {
                "rule": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "default": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "description": "The value a task has when its record does not state this rule. Must be one of `values`."
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "definition"
                    ],
                    "properties": {
                      "value": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "definition": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "motivation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "question",
          "required",
          "values"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean",
            "description": "True when every task must answer; false when asked only if a reward or loss is involved."
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "definition"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "definition": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "definition"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "combinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "how",
          "definition"
        ],
        "properties": {
          "how": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "settings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "setting",
          "definition"
        ],
        "properties": {
          "setting": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
