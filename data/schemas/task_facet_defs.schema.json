{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.hedtags.org/hed-task/schemas/task_facet_defs.schema.json",
  "title": "HED task catalog facet definitions",
  "description": "Schema for data/task_facet_defs.json, the vocabulary of task facets: one question per facet with a fixed list of values, each mapped to HED tags. Shape only; cross-checks (every hed_tags entry exists in the local HED schema, values used in task records are defined) run in src/generate_docs.py.",
  "type": "object",
  "required": [
    "facets"
  ],
  "additionalProperties": false,
  "properties": {
    "facets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/facet"
      }
    }
  },
  "definitions": {
    "facet": {
      "type": "object",
      "required": [
        "facet",
        "question",
        "description",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "facet": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
          "description": "Facet name in snake_case; the key used in task_facets."
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "description": "The question the facet asks about a task."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/value"
          }
        }
      }
    },
    "value": {
      "type": "object",
      "required": [
        "value",
        "definition",
        "hed_tags",
        "hed_note"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
          "description": "Value name in snake_case; not spelled like the HED tag it maps to."
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "hed_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "HED tags that say the same thing; empty when the standard schema has none."
        },
        "hed_note": {
          "type": "string",
          "minLength": 1,
          "description": "Exact, nearest, proposed or none, and why."
        }
      }
    }
  }
}
